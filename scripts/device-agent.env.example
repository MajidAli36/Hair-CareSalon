# Copy to device-agent.env and fill in values (device-agent.env is gitignored).
# Run: npm run device:agent
#
# You can enable drawer only, attendance only, or both on the same POS PC.

APP_URL=http://localhost:3000

# --- Cash drawer / receipt printer ---
# Register a Printer (or Cash drawer) under Devices and paste the API key.
DEVICE_API_KEY=
# Windows shared printer (escape \ as \\):
DEVICE_PRINTER=\\\\localhost\\YourPrinterShareName
# Or raw COM / serial:
# DEVICE_OUTPUT=\\\\.\\COM3
POLL_MS=1500

# --- Fingerprint / thumb attendance (optional, same agent) ---
# Register an Attendance terminal under Devices and paste that API key here.
ATTENDANCE_API_KEY=
# Local bridge for scanner SDKs / vendor middleware:
#   POST http://127.0.0.1:8787/scan  { "thumbId": "42" }
ATTENDANCE_LISTEN_PORT=8787
# ATTENDANCE_LISTEN_HOST=127.0.0.1
#
# USB scanners that type like a keyboard: leave the listen port optional and open
#   /kiosk/attendance?key=YOUR_ATTENDANCE_API_KEY
# Enroll each staff thumb ID under Attendance before scanning.
