# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Use either name (publishable is Supabase's newer label for the anon/public key)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=

# Database connection — add ONE of these (required for npm run db:setup / db:push):
# Prefer the Pooler URI (IPv4). Direct db.<ref>.supabase.co often fails on Windows (ENOTFOUND / IPv6-only).
# Dashboard → Connect → Connection string → Pooler (Transaction or Session):
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# Option 2: database password only (+ region if not Singapore):
# SUPABASE_DB_PASSWORD=your-database-password
# SUPABASE_DB_REGION=ap-southeast-1

# NEXT_PUBLIC_BOOKING_SLUG=hair-salon

# Thermal receipt paper width: 80mm (default) or 58mm
# NEXT_PUBLIC_RECEIPT_WIDTH=80mm

# Demo login (also hardcoded on /login for retest):
#   owner@salon.com / Salon123!
# Reset business data + reseed: npm run db:reset-test

# WhatsApp Business API (optional — not required for linked-device sending)
WHATSAPP_VERIFY_TOKEN=your-webhook-verify-token
WHATSAPP_WEBHOOK_SECRET=your-webhook-secret
WHATSAPP_DEFAULT_ORG_ID=your-organization-uuid

# Payment screenshots use Supabase Storage bucket "deposit-proofs" (private).
# Requires SUPABASE_SERVICE_ROLE_KEY above. Auto-cleanup frees ~100 MB of the
# oldest proofs when that bucket reaches ~980 MB (keeps you under the ~1 GB plan).

# Cash drawer / printer + fingerprint agent (run on the POS PC, not in Next.js):
# Copy scripts/device-agent.env.example → scripts/device-agent.env
# Then: npm run device:agent
# Drawer cable → thermal printer kick/DK port.
# Fingerprint: register Attendance terminal, enroll thumb IDs under Attendance,
# then use /kiosk/attendance?key=… (USB keyboard scanners) or ATTENDANCE_LISTEN_PORT bridge.

