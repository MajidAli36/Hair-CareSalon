# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Use either name (publishable is Supabase's newer label for the anon/public key)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=

# Database connection — add ONE of these (required for npm run db:setup):
# Option 1: copy full URI from Dashboard → Connect → Connection string
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-....pooler.supabase.com:6543/postgres
# Option 2: database password only (Project Settings → Database)
# SUPABASE_DB_PASSWORD=your-database-password

# NEXT_PUBLIC_BOOKING_SLUG=hair-salon

# WhatsApp Business API (optional — not required for linked-device sending)
WHATSAPP_VERIFY_TOKEN=your-webhook-verify-token
WHATSAPP_WEBHOOK_SECRET=your-webhook-secret
WHATSAPP_DEFAULT_ORG_ID=your-organization-uuid

# Linked WhatsApp (Baileys) stores session files in .whatsapp-session/ locally.
# Keep the Next.js server running so the link stays connected.
